NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room

JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

# Google Gemini API configuration
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Generation limits and options
CASE_GENERATION_LIMIT_PER_HOUR=10
CASE_MAX_SCENARIO_LENGTH=2000

# Optional image generation configuration
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=
ASSET_STORAGE_PROVIDER=
ASSET_STORAGE_BUCKET=
